# Ce que Docker ne doit pas envoyer dans le contexte de construction.
#
# `dist` est notamment exclu : l'image le recompile. L'y envoyer risquerait
# de servir une version antérieure si la copie précédait la compilation.

node_modules
dist
coverage

# Vidéos déposées en local : elles appartiennent au disque du serveur, pas à
# l'image. Les y copier gonflerait chaque build de leur poids cumulé.
uploads

.env
.env.*
!.env.example

.git
.gitignore
Dockerfile
.dockerignore

npm-debug.log*
*.tsbuildinfo
.DS_Store

# Tests : ils tournent avant le déploiement, pas dedans.
**/*.spec.ts
**/*.e2e-spec.ts
