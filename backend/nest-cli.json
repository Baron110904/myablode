{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "../data/**/*", "outDir": "./dist" },
      { "include": "assets/**/*", "outDir": "./dist" }
    ],
    "watchAssets": true
  }
}
