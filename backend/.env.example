# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origines autorisées pour le frontend (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# ─── Base de données (PostgreSQL + PostGIS) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=ablode
DB_PASSWORD=ablode
DB_NAME=ablode

# ─── Redis (cache des agrégations) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── Authentification ───────────────────────────────────────────────────────
# À REGÉNÉRER en production : openssl rand -hex 48
JWT_ACCESS_SECRET=dev-access-secret-a-changer-en-production
JWT_REFRESH_SECRET=dev-refresh-secret-a-changer-en-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── Compte super admin créé au seed ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@ablode.bj
SEED_ADMIN_PASSWORD=Ablode2026!
# Génère un jeu de dépistages de démonstration (à désactiver en production)
SEED_DEMO_DATA=true

# ─── KoboToolbox ────────────────────────────────────────────────────────────
# Ces valeurs sont éditables depuis Paramètres → Kobo dans le back-office.
KOBO_API_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=
KOBO_FORM_ID=

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
# Par défaut : Mailpit, démarré par docker compose. Il capture les messages
# sans les livrer — à lire sur http://localhost:8025
# En production, remplacez par votre serveur (ou renseignez-le dans
# l'interface : Paramètres → Email, qui a priorité sur ces valeurs).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ABLODE <contact@ablode.bj>

# ─── Sécurité ───────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
