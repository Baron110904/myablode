# Modèle d'environnement pour le déploiement de test de MyABLODE.
#
# Copiez ce fichier en `.env.production`, remplissez les valeurs marquées
# « À REMPLIR », puis lancez :
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Ne versionnez jamais `.env.production` : il contient les secrets.

# ─── Adresses publiques ────────────────────────────────────────────────────
# SITE_URL sert d'origine autorisée pour l'API (CORS). API_URL est inscrite
# dans le JavaScript du navigateur à la construction de l'image : la changer
# impose de reconstruire.
#
# Avec un nom de domaine et un reverse proxy :
#   SITE_URL=https://test.ablode.bj
#   API_URL=https://api-test.ablode.bj
# Sans domaine, en accès direct par IP :
#   SITE_URL=http://203.0.113.10:3000
#   API_URL=http://203.0.113.10:4000
SITE_URL=À REMPLIR
API_URL=À REMPLIR

# Ports publiés sur la machine hôte.
WEB_PORT=3000
API_PORT=4000

# ─── Base de données ───────────────────────────────────────────────────────
DB_USER=ablode
DB_NAME=ablode
# À REMPLIR — générer avec : openssl rand -base64 24
DB_PASSWORD=À REMPLIR

# ─── Cache ─────────────────────────────────────────────────────────────────
# À REMPLIR — générer avec : openssl rand -base64 24
REDIS_PASSWORD=À REMPLIR

# ─── Jetons de session ─────────────────────────────────────────────────────
# Deux secrets DISTINCTS, 32 octets minimum chacun.
# Générer avec : openssl rand -base64 48
#
# Les réutiliser d'un environnement à l'autre permettrait à un jeton émis
# ailleurs d'être accepté ici.
JWT_ACCESS_SECRET=À REMPLIR
JWT_REFRESH_SECRET=À REMPLIR

# `true` impose que le cookie de session ne circule qu'en HTTPS. Passez à
# `false` seulement si le site est servi en HTTP simple — la session serait
# alors interceptable sur le réseau.
COOKIE_SECURE=true

# Politique d'envoi du cookie de session.
#   lax   site et API sur le même domaine (déploiement Docker d'un seul tenant)
#   none  site et API sur des domaines différents (Vercel + Render, par exemple)
#
# `none` impose HTTPS des deux côtés ; l'application force alors `secure`.
COOKIE_SAMESITE=lax

# ─── Base infogérée ────────────────────────────────────────────────────────
# Neon, Supabase, Railway livrent une chaîne unique. Renseignée, elle prime
# sur DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME ci-dessus.
#   DATABASE_URL=postgresql://user:motdepasse@ep-xxx.aws.neon.tech/ablode
DATABASE_URL=

# Chiffrement de la liaison à la base. `true` avec une base infogérée,
# `false` avec le conteneur PostgreSQL de ce compose.
DB_SSL=false

# ─── Envoi de courriels ────────────────────────────────────────────────────
# Sans serveur d'envoi, l'application démarre quand même : les courriels
# échouent en étant journalisés, et le reste fonctionne. Pour une phase de
# test avec des parties prenantes, c'est souvent suffisant.
#
# Exemple avec un compte Gmail et un mot de passe d'application :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=contact@ablode.bj
#   SMTP_PASSWORD=mot-de-passe-d-application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ABLODE <contact@ablode.bj>

# ─── Jeu de démonstration ──────────────────────────────────────────────────
# `true` autorise la création des 11 732 dépistages fictifs répartis sur les
# 77 communes — indispensable pour que les écrans aient quelque chose à
# montrer. Passez à `false` avant une mise en service réelle.
SEED_DEMO_DATA=true

# Compte administrateur créé par le seed. Changez le mot de passe depuis
# l'interface après la première connexion.
SEED_ADMIN_EMAIL=admin@ablode.bj
SEED_ADMIN_PASSWORD=Ablode2026!
